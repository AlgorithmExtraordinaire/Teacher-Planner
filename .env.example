# Supabase — safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scheduled workflow runner -------------------------------------------
# Shared secret for POST /api/cron/workflows. The scheduler sends it as
# "Authorization: Bearer <value>". This route is exempt from the login
# redirect, so this secret is the only thing guarding it — generate a long
# random value (e.g. `openssl rand -hex 32`) and never reuse it elsewhere.
CRON_SECRET=

# Supabase service-role key — BYPASSES Row Level Security.
# Used only by the cron runner, which must write system_alerts with no user
# session. Server-side only: never prefix with NEXT_PUBLIC_, never ship to a
# browser bundle. Without it, scheduled runs return 503.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for the Assistant (Google AI Studio > Get API key).
# A real API key starts with "AIza". An "AQ."-prefixed value is a short-lived
# OAuth access token and will stop working within the hour — don't use one here.
# Server-side only: never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
